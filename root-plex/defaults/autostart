#!/usr/bin/with-contenv bash

# Plex direct launch - bypass selkies desktop manager
# We start our own minimal wayland session

export QT_QPA_PLATFORM=wayland
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export KDE_SESSION_VERSION=6
export WAYLAND_DISPLAY=wayland-0
unset DISPLAY
unset XDG_RUNTIME_DIR

# Create our own XDG runtime dir
mkdir -p /config/.XDG
export XDG_RUNTIME_DIR=/config/.XDG

# Kill any existing kwin/xwayland
pkill -9 kwin_wayland 2>/dev/null || true
pkill -9 Xwayland 2>/dev/null || true
sleep 1

# Start dbus
mkdir -p /var/run/dbus
dbus-daemon --system --fork 2>/dev/null || true
dbus-run-session -- sh -c '
    # Start our own kwin
    export WAYLAND_DISPLAY=wayland-0
    export QT_QPA_PLATFORM=wayland
    export XDG_CURRENT_DESKTOP=KDE
    export XDG_SESSION_TYPE=wayland

    kwin_wayland --no-lockscreen --no-global-shortcuts --xwayland &>/tmp/kwin.log &
    KWIN_PID=$!

    sleep 3

    # Verify kwin started
    if pgrep -x kwin_wayland > /dev/null; then
        echo "kwin started, launching Plex" > /tmp/kwin.log
        export WAYLAND_DISPLAY=wayland-0
        exec Plex --platform=wayland &>/tmp/plex.log
    else
        echo "kwin failed to start" > /tmp/kwin.log
        cat /tmp/kwin.log
    fi

    wait $KWIN_PID 2>/dev/null
' &

# Keep container alive
sleep infinity